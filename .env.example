# Copy to .env and adjust. Used by docker-compose.yaml.

# Password of the qstatslite database user (required).
DB_PASSWORD=change-me

# Address the web interface listens on. The application has no login of its
# own, so the default is this host only. "8080" listens on all addresses.
#WEB_PORT=127.0.0.1:8080

# Asterisk Manager Interface for the realtime tab (/etc/asterisk/manager.conf).
# host.docker.internal is the Docker host.
#AMI_HOST=host.docker.internal
#AMI_USER=qstats
AMI_PASSWORD=

# Directory with queue_log on the host.
#ASTERISK_LOG_DIR=/var/log/asterisk

# Store Local/101@context agents as Agent/101.
#CONVERT_LOCAL=true

# Time zone used for queue_stats.datetime (default UTC). Changing it on an
# existing database shifts new events against the old ones.
#TZ=Europe/Warsaw
